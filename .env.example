DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Host-side port mappings (change these if 5432/6379/8000 are already in use
# on your machine, e.g. by another project's containers). These only affect
# how the ports are published to your host; the values above, used for the
# app's internal connections between containers, stay the same.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
WEB_HOST_PORT=8000
